# Config Next.js (PWA joueurs) pour un lancement local (`npm run dev`).
# En Docker, ces variables sont injectées par compose.yml (environment + build.args).
# ⚠️ Les variables NEXT_PUBLIC_* sont inlinées dans le bundle AU BUILD :
#    en Docker, les passer via `build.args`, pas seulement via `environment`.

API_URL=changeMe               # URL de l'API côté serveur ET cible du rewrite "/api/*" — ex: http://localhost:8000 (local) / http://api:8000 (Docker)
NEXT_PUBLIC_API_URL=changeMe   # URL de l'API côté client, "/api" recommandé (proxy via rewrite : même origine, pas de CORS ni de mixed content) — ex: /api

# --- Assets (images de couverture, modèles .glb) servis par MinIO/S3 ---
NEXT_PUBLIC_ASSETS_BASE_URL=changeMe   # base URL des assets côté client, "/assets" recommandé (passe par le rewrite Next.js) — ex: /assets
MINIO_INTERNAL_URL=changeMe            # cible interne du rewrite "/assets/*", côté serveur uniquement — ex: http://localhost:9000 (local) / http://minio:9000 (Docker)
S3_BUCKET=changeMe                     # bucket MinIO visé par le rewrite — ex: lootopia-public

# --- Web Push Notifications (paire générée via `npx web-push generate-vapid-keys`) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=changeMe   # clé VAPID publique, exposée au client pour la subscription push — ex: BNx…(87 caractères base64url)
VAPID_PRIVATE_KEY=changeMe              # clé VAPID privée, ne JAMAIS exposer au client

# --- Debug AR (optionnel, dev uniquement) ---
# NEXT_PUBLIC_AR_FAKE_GPS=true   # simule la position GPS dans la vue AR pour tester sans bouger (apps/pwa/app/ar/page.tsx). Laisser vide/absent en temps normal.
