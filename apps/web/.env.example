# Config Next.js (portail web partenaires/admin) pour un lancement local (`npm run dev`).
# En Docker, ces variables sont injectées par compose.yml (environment + build.args).
# ⚠️ Les variables NEXT_PUBLIC_* sont inlinées dans le bundle AU BUILD :
#    en Docker, les passer via `build.args`, pas seulement via `environment`.

API_URL=changeMe               # URL de l'API côté serveur (SSR, server actions) — ex: http://localhost:8000 (local) / http://api:8000 (Docker)
NEXT_PUBLIC_API_URL=changeMe   # URL de l'API côté client (navigateur), doit être joignable depuis la machine de l'utilisateur — ex: http://localhost:8000

# --- Assets (images de couverture, modèles .glb) servis par MinIO/S3 ---
NEXT_PUBLIC_ASSETS_BASE_URL=changeMe   # base URL des assets côté client, "/assets" recommandé (passe par le rewrite Next.js) — ex: /assets
MINIO_INTERNAL_URL=changeMe            # cible interne du rewrite "/assets/*", côté serveur uniquement — ex: http://localhost:9000 (local) / http://minio:9000 (Docker)
S3_BUCKET=changeMe                     # bucket MinIO visé par le rewrite — ex: lootopia-public

# --- Test AR sur mobile ---
NEXT_PUBLIC_LAN_IP=changeMe   # IP LAN de la machine de dev, pour le QR code de test AR ouvert depuis un smartphone — ex: 192.168.1.42
