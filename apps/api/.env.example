# Config NestJS pour un lancement local (`npm run dev`).
# En Docker, ces variables sont injectées par compose.yml — ce fichier n'est pas lu.

PORT=changeMe           # port d'écoute du serveur NestJS — ex: 8000
DATABASE_URL=changeMe   # URL Postgres au format Prisma — ex: postgresql://lootopia:lootopia@localhost:5432/lootopia?schema=public
JWT_SECRET=changeMe     # clé de signature des JWT (auth + guards) — générer via `openssl rand -base64 48`

# --- Stockage objet S3-compatible (MinIO en dev) ---
S3_ENDPOINT=changeMe     # endpoint utilisé par le SDK côté serveur — ex: http://localhost:9000 (local) / http://minio:9000 (Docker)
S3_PUBLIC_URL=changeMe   # URL publique servie au navigateur pour télécharger les objets — ex: http://localhost:9000
S3_BUCKET=changeMe       # bucket des assets publics — ex: lootopia-public
S3_ACCESS_KEY=changeMe   # access key S3 (= MINIO_ROOT_USER en dev) — ex: minioadmin
S3_SECRET_KEY=changeMe   # secret key S3 (= MINIO_ROOT_PASSWORD en dev) — ex: minioadmin
S3_REGION=changeMe       # région S3 (sans effet avec MinIO) — ex: us-east-1

# --- Email (SMTP — Mailpit en dev, UI sur http://localhost:8025) ---
MAIL_HOST=changeMe        # hôte SMTP — ex: localhost (local) / mailpit (Docker) / smtp.azurecomm.net (ACS)
MAIL_PORT=changeMe        # port SMTP — ex: 1025 (Mailpit) / 587 (ACS, STARTTLS)
MAIL_FROM=changeMe        # adresse expéditrice des emails — ex: noreply@lootopia.local (doit être sur le domaine vérifié ACS en prod)
MAIL_FROM_NAME=changeMe   # nom d'expéditeur affiché — ex: Lootopia
MAIL_USER=changeMe        # utilisateur SMTP — VIDE en dev (Mailpit sans auth) ; non utilisé si ACS_CONNECTION_STRING défini
MAIL_PASS=changeMe        # mot de passe SMTP — VIDE en dev ; non utilisé si ACS_CONNECTION_STRING défini
# Prod email via Azure Communication Services (SDK, auth par clé — aucune app Entra requise).
# Si défini, prime sur la config SMTP ci-dessus. MAIL_FROM doit être un sender du domaine ACS vérifié.
ACS_CONNECTION_STRING=changeMe   # ex: endpoint=https://<acs>.communication.azure.com/;accesskey=...

# --- URLs des fronts (liens générés dans les emails) ---
APP_URL_PWA=changeMe   # URL publique de la PWA — ex: https://localhost:3001
APP_URL_WEB=changeMe   # URL publique du portail web — ex: https://localhost:3000
