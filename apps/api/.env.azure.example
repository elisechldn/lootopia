# Connexion à l'environnement Azure déployé — utilisé par `make reset-azure`.
# Copier en `apps/api/.env.azure` (gitignored) et remplir avec les vraies valeurs.
# NE JAMAIS committer apps/api/.env.azure.

# URL Postgres prod au format Prisma (sslmode=require obligatoire sur Azure)
# Reconstructible depuis azure-cmd.md : user `lootopia`, host lootopia-pg-22205.postgres.database.azure.com
AZURE_DATABASE_URL=postgresql://USER:PASS@lootopia-pg-22205.postgres.database.azure.com:5432/DB?sslmode=require&schema=public

# Identifiants root MinIO = secrets S3 de l'app ACA lootopia-minio
AZURE_MINIO_USER=changeMe        # = S3_ACCESS_KEY / MINIO_ROOT_USER
AZURE_MINIO_PASS=changeMe        # = S3_SECRET_KEY / MINIO_ROOT_PASSWORD
AZURE_MINIO_BUCKET=lootopia-public
