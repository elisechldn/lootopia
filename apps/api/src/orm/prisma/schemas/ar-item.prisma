model ArItem {
  id            String   @id @default(uuid())
  filename      String
  filepath      String   @unique
  hasAnimations Boolean  @default(false) @map("has_animations")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  steps Step[]

  @@map("ar_items")
}
