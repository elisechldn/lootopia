# Variables consommées par compose.yml (lancement via `docker compose up`).
# Pour un lancement local (`npm run dev`), voir les .env.example de chaque app
# (apps/api, apps/web, apps/pwa).

# --- Postgres (service `db`) ---
POSTGRES_USER=changeMe       # utilisateur de la base — ex: lootopia
POSTGRES_PASSWORD=changeMe   # mot de passe de la base — ex: lootopia
POSTGRES_DB=changeMe         # nom de la base — ex: lootopia

# --- pgAdmin (UI d'admin BDD, http://localhost:5050) ---
PGADMIN_DEFAULT_EMAIL=changeMe      # email de connexion pgAdmin — ex: lootopia@lootopia.com
PGADMIN_DEFAULT_PASSWORD=changeMe   # mot de passe pgAdmin — ex: lootopia

# --- MinIO (stockage objet S3-compatible, console http://localhost:9001) ---
MINIO_ROOT_USER=changeMe       # identifiant admin MinIO (= S3_ACCESS_KEY de l'API) — ex: minioadmin
MINIO_ROOT_PASSWORD=changeMe   # mot de passe admin MinIO (= S3_SECRET_KEY de l'API) — ex: minioadmin
MINIO_BUCKET=changeMe          # bucket public des assets (images, modèles .glb) — ex: lootopia-public

# --- API ---
JWT_SECRET=changeMe   # clé de signature des tokens d'auth, OBLIGATOIRE (l'API plante au boot si absente) — générer via `openssl rand -base64 48`
